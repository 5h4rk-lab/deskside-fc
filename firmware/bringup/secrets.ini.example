; Copy this file to secrets.ini (same folder) and fill in your Wi-Fi.
; secrets.ini is git-ignored; never commit it.
;
;   cp secrets.ini.example secrets.ini
;
; With credentials the firmware connects after the scan, prints its IP and
; RSSI and downloads one small PNG over HTTPS. Without secrets.ini it only
; scans. Keep the quoting exactly as shown: single quotes around the whole
; flag, double quotes around the value (spaces in the SSID/password are fine).
; A password containing ' or " needs extra escaping; easier to test with a
; phone hotspot that has a plain password.

[secrets]
wifi_flags =
    '-DWIFI_SSID="Your Network Name"'
    '-DWIFI_PASS="YourPassword"'
