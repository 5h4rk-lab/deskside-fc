; Copy this file to secrets.ini (same folder) and fill it in.
; secrets.ini is git-ignored; never commit it.
;
;   cp secrets.ini.example secrets.ini
;
; HELPER_URL and HELPER_TOKEN are build-time defaults for the helper the
; device talks to. Keep the quoting exactly as shown: single quotes around
; the whole flag, double quotes around the value. The URL must be https://
; and neither value may contain control characters.
; The token ends up inside the firmware image: only flash images built with
; your own secrets.ini onto your own device, never publish them.

[secrets]
helper_flags =
    '-DHELPER_URL="https://your-helper.example.com"'
    '-DHELPER_TOKEN="your-helper-token"'
