; OPTIONAL build-time defaults for the helper. You normally do NOT need this
; file: the device keeps the helper's URL and token in its settings flash
; (NVS, namespace "helper"), written over the USB serial console:
;
;   tools/provision-helper.sh --restart
;
; (reads HELPER_TOKEN from ~/.config/soccer-display/helper.env, sends
; :set-url and :set-token, checks with :show-config that only a masked token
; is shown, never prints the token). By hand, in a serial terminal:
;   :set-url https://soccer-display-helper.vercel.app   (Enter)
;   :set-token <token>                                    (Enter)
;   :show-config                                          (Enter)
;   :restart                                              (Enter)
; Values saved in NVS win over the defaults below; a value that fails the
; checks (https only, no user info, no control characters, URL at most 200
; characters, token 16 to 128 printable characters without spaces) is never
; used, and then the device makes no requests at all.
;
; If you still want build defaults: copy this file to secrets.ini (same
; folder; git-ignored, never commit it) and fill it in.
;
;   cp secrets.ini.example secrets.ini
;
; Keep the quoting exactly as shown: single quotes around the whole flag,
; double quotes around the value. A token given here ends up inside the
; firmware image: only flash images built with your own secrets.ini onto your
; own device, never publish them, and prefer the NVS route above.

[secrets]
helper_flags =
    '-DHELPER_URL="https://your-helper.example.com"'
    '-DHELPER_TOKEN="your-helper-token"'
